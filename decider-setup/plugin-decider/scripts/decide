#!/usr/bin/env python3
"""decide — CLI for the decider plugin's swap-ready decision client.

Usage:
  scripts/decide --state "TEXT" [--state-file PATH] 
                 (--template NAME | --questions-file PATH)
                 [--model NAME] [--timeout S] [--no-cache] [--pretty]
  scripts/decide --list-models
  scripts/decide --list-templates

Questions come from a template (templates/NAME.json) or a JSON file with the
same shape: {"questions": [{name, type, instructions, criteria?...}, ...]}
(a bare dict {name: spec} is also accepted).

Output: one JSON object on stdout.
  ok:true  -> {"ok", "model", "answers", "usage", "latency_s", "cached"}
  ok:false -> {"ok", "error", "model"}          # NEVER a guessed verdict
Exit codes: 0 decided, 3 decider/transport error (JSON still printed), 2 usage.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

_PLUGIN_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_PLUGIN_DIR))
import decider_client  # noqa: E402

TEMPLATES_DIR = _PLUGIN_DIR / "templates"


def _load_questions(args) -> dict:
    if args.questions_file:
        raw = Path(args.questions_file).read_text(encoding="utf-8")
    elif args.template:
        raw = (TEMPLATES_DIR / f"{args.template}.json").read_text(encoding="utf-8")
    else:
        raise SystemExit("pick questions via --template NAME or --questions-file PATH")
    doc = json.loads(raw)
    questions = doc.get("questions", doc) if isinstance(doc, dict) else doc
    return decider_client._normalize_questions(questions)


def _load_state(args) -> str:
    if args.state is not None:
        return args.state
    if args.state_file:
        return sys.stdin.read() if args.state_file == "-" else \
            Path(args.state_file).read_text(encoding="utf-8")
    raise SystemExit("provide state via --state TEXT or --state-file PATH")


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="decide", description=__doc__.splitlines()[0])
    p.add_argument("--state"); p.add_argument("--state-file")
    p.add_argument("--template"); p.add_argument("--questions-file")
    p.add_argument("--model"); p.add_argument("--timeout", type=float)
    p.add_argument("--no-cache", action="store_true")
    p.add_argument("--registry", help="alternate models.json path")
    p.add_argument("--pretty", action="store_true")
    p.add_argument("--list-models", action="store_true")
    p.add_argument("--list-templates", action="store_true")
    args = p.parse_args(argv)

    pretty = {"indent": 2, "sort_keys": True} if args.pretty else {}
    if args.list_models:
        print(json.dumps(decider_client.list_models(args.registry), **pretty)); return 0
    if args.list_templates:
        names = sorted(f.stem for f in TEMPLATES_DIR.glob("*.json"))
        print(json.dumps({"templates": names}, **pretty)); return 0

    try:
        questions = _load_questions(args)
        state = _load_state(args)
    except (OSError, ValueError, KeyError, json.JSONDecodeError) as exc:
        print(json.dumps({"ok": False, "error": f"usage: {exc}"}), file=sys.stderr)
        return 2

    out = decider_client.ask(state, questions, model=args.model,
                             registry_path=args.registry, timeout=args.timeout,
                             use_cache=not args.no_cache)
    print(json.dumps(out, **pretty))
    return 0 if out.get("ok") else 3


if __name__ == "__main__":
    sys.exit(main())
